AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.edgeone.link/v1
AI_GATEWAY_MODEL=@makers/deepseek-v4-flash
# Optional master token. It stays in the Agent Runtime and only mints short-lived
# per-project tenant tokens into direct sandbox CLI calls.
EDGEONE_PAGES_API_TOKEN=
MAKERS_SUB_TOKEN_TTL_SECONDS=3600
# Leave unset. Preview and deploy then use a project derived from the
# conversation, so later turns reach the same site and two users never collide
# over one name. Setting it pins every conversation to the project named here.
# MAKERS_DEPLOY_PROJECT_NAME=
